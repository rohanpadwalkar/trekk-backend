# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:19006,exp://192.168.1.10:19000

# --- MongoDB (Atlas) ---
# Use the connection string from your Atlas cluster's "Connect > Drivers"
# page as-is — it already includes retryWrites/majority params and Atlas's
# free M0 tier is already a replica set, which this app requires (it uses
# multi-document transactions for atomic seat booking; Mongo only supports
# transactions on a replica set, even a single-node one).
MONGO_URI=mongodb+srv://user:password@your-cluster.mongodb.net/trekk_together?retryWrites=true&w=majority

# --- Redis (Upstash) ---
# Upstash gives you TWO connection strings for the SAME database — this app
# needs both, for two different reasons:
#
# 1. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — the REST API
#    (Upstash dashboard: your database > "REST API" tab). Used for the
#    trek-list cache and the rate-limit store, both hit on nearly every
#    request. REST has no TCP connection to hold open, so it can't be
#    exhausted by a burst of concurrently-scaled Vercel Function instances
#    the way a pooled TCP client can — see docs/10-backend-design.md.
# 2. REDIS_URL — the standard "rediss://" TCP connection string (Upstash
#    dashboard: same database > "Redis" tab / "TLS" connect string). Used
#    ONLY by the Socket.IO adapter (main.ts), which needs a real duplex
#    pub/sub client — REST can't do that.
#
# If you leave UPSTASH_REDIS_REST_URL/TOKEN unset, the app falls back to
# using REDIS_URL (ioredis/TCP) for the cache and rate-limiter too — this is
# what local `docker compose` dev does automatically, since a plain Redis
# container has no REST endpoint. Only set both Upstash vars in real
# (Vercel) deployments.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# --- JWT ---
# Generate strong random secrets for real environments, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OAuth ---
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
APPLE_CLIENT_ID=replace-with-apple-services-id
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id

# --- Supabase Storage (S3-compatible interface) ---
# This connects to Supabase Storage via its S3-compatible API rather than
# the native @supabase/supabase-js Storage client. That's deliberate, not a
# stand-in: Supabase's own docs point to this same S3 interface for
# presigned/direct uploads, it's what supports the "AWS SigV4 presigned PUT
# URL" pattern this app relies on (POST /uploads/presign — see README.md
# "Upload pattern"), and the exact same code also works unchanged against
# Cloudflare R2, self-hosted MinIO, or real AWS S3 by only changing these
# vars. The values below map to Supabase dashboard: Storage > Settings > S3
# Connection (URL/region) and the access key pair you generate there (NOT
# your Supabase project's anon/service_role API keys — those are separate).
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-project-region
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_FORCE_PATH_STYLE=true
# Base URL used to build public (non-presigned) read links for the 4
# public-read buckets. For Supabase this is the project's public object URL
# base — see README.md.
S3_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
